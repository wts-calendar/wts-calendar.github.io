{
  "name": "wts-calendar-angular-example",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:pages": "ng build --base-href /wts-calendar-angular-example/ && node scripts/prepare-pages.mjs /wts-calendar-angular-example/ && node scripts/verify-pages.mjs",
    "build:pages:org": "ng build --base-href / && node scripts/prepare-pages.mjs / && node scripts/verify-pages.mjs /",
    "check:showcase": "node scripts/verify-showcase.mjs",
    "check:release": "node scripts/verify-showcase.mjs --require-contact"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/platform-server": "22.1.3",
    "@angular/router": "22.1.3",
    "@angular/ssr": "22.1.6",
    "@wts-calendar/angular": "^1.0.0",
    "@wts-calendar/core": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
